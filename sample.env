# llama-mon configuration
# Copy this file to .env and adjust values as needed.
# CLI arguments always override environment variables.

# ── Server(s) to monitor ─────────────────────────────────────
# URL or host:port of one or more llama-server instances.
# Can be specified multiple times (one per line, or comma-separated).
LLAMA_MON_SERVER_URL=http://localhost:8080

# ── Polling ──────────────────────────────────────────────────
# How often to poll the server(s). Supports durations like "5s", "30s", "1m".
LLAMA_MON_POLL_INTERVAL=5s

# HTTP request timeout for each poll cycle.
LLAMA_MON_TIMEOUT=10s

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file. Parent directory is created if missing.
LLAMA_MON_DB_PATH=~/.local/share/llama-mon/data.db

# ── Model filter ─────────────────────────────────────────────
# Restrict scraping to specific model name(s). Omit to scrape all models.
# Can be specified multiple times.
# LLAMA_MON_MODEL=gemma-2-9b
# LLAMA_MON_MODEL=llama-3.1-8b

# ── Web Dashboard ────────────────────────────────────────────
# Port for the embedded web dashboard. Omit (or set to 0) to disable.
# When set, the dashboard is available at http://<listen-ip>:<listen-port>.
LLAMA_MON_WEB_PORT=8081

# IP address the dashboard binds to. 127.0.0.1 = localhost only;
# 0.0.0.0 = all interfaces (use with caution).
LLAMA_MON_LISTEN_IP=127.0.0.1

# ── Verbosity ────────────────────────────────────────────────
# Logging levels (mutually exclusive). Only one should be set.
# --silent:   No log output
# --quiet:    Errors only
# (default):  Warnings and above
# --verbose:  Info and above
# --debug:    Debug and above
# Alternatively, use the RUST_LOG environment variable for fine-grained
# control, e.g. RUST_LOG=warn,hyper=info
# LLAMA_MON_VERBOSE=1

# ── Other ────────────────────────────────────────────────────
# Exit after the first unsuccessful poll cycle (useful for debugging).
# LLAMA_MON_FAIL_FAST=1
